<div class="booking-widget">
  <div id="booking-details" class="booking-view">
    <form id="booking-details-form" class="booking-fields">
      <div class="booking-field">
        <label for="reservation-type">Tipo de reserva</label>
        <select id="reservation-type" required>
          <option value="hospedaje">Solo hospedaje</option>
          <option value="evento">Evento privado</option>
          <option value="cumple">Cumpleaños</option>
          <option value="empresarial">Empresarial</option>
          <option value="boda">Boda</option>
          <option value="otro">Otro</option>
        </select>
      </div>
      <div class="booking-field">
        <label for="arrival-date">Fecha de llegada</label>
        <input type="date" id="arrival-date" required />
      </div>
      <div class="booking-field">
        <label for="stay-days">Cantidad de días</label>
        <input type="number" id="stay-days" min="1" max="365" value="1" inputmode="numeric" required />
      </div>
      <button type="submit" class="booking-btn">Continuar</button>
    </form>
  </div>

  <div id="booking-form" class="booking-view hidden">
    <div class="booking-summary" aria-live="polite">
      <span id="summary-type">-</span>
      <span id="summary-dates">-</span>
    </div>
    <form id="reservation-form" class="reservation-form">
      <div class="form-row">
        <input type="text" name="name" placeholder="Nombre*" autocomplete="name" required />
        <input type="email" name="email" placeholder="Email*" autocomplete="email" required />
        <input type="tel" name="phone" placeholder="Teléfono*" autocomplete="tel" required />
      </div>
      <div class="form-row">
        <textarea name="message" placeholder="Mensaje (opcional)" rows="1"></textarea>
      </div>
      <p id="form-error" class="form-error hidden" role="alert"></p>
      <div class="form-row form-actions">
        <button type="button" class="booking-btn-secondary" id="btn-back">← Volver</button>
        <button type="submit" class="booking-btn">Enviar solicitud</button>
      </div>
    </form>
  </div>

  <div id="booking-confirm" class="booking-view hidden">
    <div class="confirm-inline">
      <span class="confirm-check">✓</span>
      <span>¡Solicitud enviada! Te contactaremos pronto.</span>
      <a id="confirm-whatsapp" href="#" target="_blank" rel="noopener" class="whatsapp-link">Enviar por WhatsApp</a>
      <button type="button" class="booking-btn-secondary" id="btn-new">Nueva solicitud</button>
    </div>
  </div>
</div>

<style is:global>
  .booking-widget {
    width: 100%; max-width: 1000px; position: relative; z-index: 1000; padding: 16px;
    background: rgba(0, 0, 0, 0.5); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 14px;
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); box-sizing: border-box;
  }
  .booking-view { animation: fadeUp 0.3s ease; }
  .booking-view.hidden, .form-error.hidden { display: none !important; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

  .booking-fields {
    display: flex; gap: 6px; align-items: stretch; background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 12px; padding: 6px;
  }
  .booking-field {
    flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; padding: 4px 10px;
    border-radius: 8px; transition: background 0.2s;
  }
  .booking-field:hover { background: rgba(255, 255, 255, 0.06); }
  .booking-field label {
    font: 500 10px 'Instrument Sans', sans-serif; color: rgba(255, 255, 255, 0.5); text-transform: uppercase;
    letter-spacing: 0.06em; margin-bottom: 2px;
  }
  .booking-field input, .booking-field select {
    width: 100%; height: 28px; padding: 0; border: none; background: transparent; color: #fff;
    font: 500 13px 'Instrument Sans', sans-serif; box-sizing: border-box;
  }
  .booking-field input:focus, .booking-field select:focus { outline: none; }
  .booking-field select { cursor: pointer; }
  .booking-field select option { background: #1a1a1a; color: #fff; }
  .booking-field input[type='date']::-webkit-calendar-picker-indicator { filter: invert(1); cursor: pointer; }

  .booking-btn {
    height: auto; padding: 0 20px; border: none; border-radius: 8px; background: #fff; color: #000;
    font: 600 13px 'Instrument Sans', sans-serif; cursor: pointer; transition: all 0.2s; white-space: nowrap; flex-shrink: 0;
  }
  .booking-btn:hover:not(:disabled) { background: rgba(255, 255, 255, 0.9); }
  .booking-btn:disabled { opacity: 0.35; cursor: not-allowed; }
  .booking-btn-secondary {
    padding: 0 16px; height: 36px; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px;
    background: transparent; color: rgba(255, 255, 255, 0.7); font: 500 13px 'Instrument Sans', sans-serif;
    cursor: pointer; transition: all 0.2s;
  }
  .booking-btn-secondary:hover { background: rgba(255, 255, 255, 0.06); color: #fff; }

  .booking-summary {
    display: flex; justify-content: center; gap: 20px; padding: 10px 16px; background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 10px; margin-bottom: 10px;
    font: 400 13px 'Instrument Sans', sans-serif; color: rgba(255, 255, 255, 0.7);
  }
  #summary-type { color: #fff; }
  .reservation-form { display: flex; flex-direction: column; gap: 8px; }
  .form-row { display: flex; gap: 8px; }
  .reservation-form input, .reservation-form textarea {
    flex: 1; padding: 10px 12px; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px;
    background: rgba(255, 255, 255, 0.05); color: #fff; font: 400 13px 'Instrument Sans', sans-serif; box-sizing: border-box;
  }
  .reservation-form input:focus, .reservation-form textarea:focus { outline: none; border-color: rgba(255, 255, 255, 0.3); }
  .reservation-form input::placeholder, .reservation-form textarea::placeholder { color: rgba(255, 255, 255, 0.35); }
  .reservation-form textarea { resize: none; min-height: 36px; }
  .form-actions { margin-top: 2px; }
  .form-actions .booking-btn { flex: 1; }
  .form-error { margin: 0; color: #fca5a5; font: 400 12px 'Instrument Sans', sans-serif; }

  .confirm-inline {
    display: flex; align-items: center; gap: 12px; padding: 12px 16px; background: rgba(74, 222, 128, 0.08);
    border: 1px solid rgba(74, 222, 128, 0.2); border-radius: 10px; font: 400 13px 'Instrument Sans', sans-serif;
    color: rgba(255, 255, 255, 0.8);
  }
  .confirm-check {
    width: 26px; height: 26px; border-radius: 50%; background: rgba(74, 222, 128, 0.15); color: #4ade80;
    font-size: 13px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .whatsapp-link {
    padding: 6px 12px; border-radius: 6px; background: #25d366; color: #fff; font: 600 12px 'Instrument Sans', sans-serif;
    text-decoration: none; white-space: nowrap;
  }
  @media (max-width: 768px) {
    .booking-fields { flex-wrap: wrap; padding: 8px; }
    .booking-field { flex: 1 1 calc(50% - 4px); min-width: calc(50% - 4px); padding: 8px 12px; }
    .booking-field:first-child { flex-basis: 100%; }
    .booking-field label { font-size: 9px; }
    .booking-field input, .booking-field select { height: 32px; font-size: 14px; }
    .booking-btn { flex: 1 1 100%; height: 44px; margin-top: 4px; }
    .form-row, .booking-summary, .confirm-inline { flex-direction: column; align-items: stretch; }
    .booking-summary { gap: 4px; text-align: center; }
    .confirm-inline { text-align: center; }
    .confirm-check { align-self: center; }
  }
</style>

<script>
  function initBookingWidget() {
    const detailsForm = document.getElementById('booking-details-form') as HTMLFormElement | null;
    if (!detailsForm || detailsForm.dataset.initialized) return;
    detailsForm.dataset.initialized = 'true';

    const bookingDetails = document.getElementById('booking-details')!;
    const bookingForm = document.getElementById('booking-form')!;
    const bookingConfirm = document.getElementById('booking-confirm')!;
    const arrivalDateInput = document.getElementById('arrival-date') as HTMLInputElement;
    const stayDaysInput = document.getElementById('stay-days') as HTMLInputElement;
    const reservationType = document.getElementById('reservation-type') as HTMLSelectElement;
    const form = document.getElementById('reservation-form') as HTMLFormElement;
    const formError = document.getElementById('form-error')!;
    const whatsappBtn = document.getElementById('confirm-whatsapp') as HTMLAnchorElement;
    const btnBack = document.getElementById('btn-back')!;
    const btnNew = document.getElementById('btn-new')!;

    const months = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
    const daysOfWeek = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];
    const today = new Date();
    const localToday = new Date(today.getTime() - today.getTimezoneOffset() * 60000).toISOString().split('T')[0];
    arrivalDateInput.min = localToday;

    function formatDate(dateString: string): string {
      const date = new Date(`${dateString}T00:00:00`);
      return `${daysOfWeek[date.getDay()]} ${date.getDate()} ${months[date.getMonth()]}`;
    }

    function getDays(): number { return Number.parseInt(stayDaysInput.value, 10); }

    function getDepartureDate(): string {
      const date = new Date(`${arrivalDateInput.value}T00:00:00`);
      date.setDate(date.getDate() + getDays());
      const offset = date.getTimezoneOffset() * 60000;
      return new Date(date.getTime() - offset).toISOString().split('T')[0];
    }

    function resetError() {
      formError.textContent = '';
      formError.classList.add('hidden');
    }

    detailsForm.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!detailsForm.reportValidity()) return;

      const stayDays = getDays();
      const reservationLabel = reservationType.selectedOptions[0]?.textContent?.trim() || 'Reserva';
      document.getElementById('summary-type')!.textContent = reservationLabel;
      document.getElementById('summary-dates')!.textContent = `${formatDate(arrivalDateInput.value)} · ${stayDays} día${stayDays === 1 ? '' : 's'}`;
      bookingDetails.classList.add('hidden');
      bookingForm.classList.remove('hidden');
      resetError();
    });

    btnBack.addEventListener('click', () => {
      bookingForm.classList.add('hidden');
      bookingDetails.classList.remove('hidden');
      resetError();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      resetError();
      const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      submitButton.textContent = 'Enviando...';
      submitButton.disabled = true;

      const formData = new FormData(form);
      const stayDays = getDays();
      const departureDate = getDepartureDate();
      const data = {
        reservation_type: reservationType.value,
        arrival_date: arrivalDateInput.value,
        days: stayDays,
        departure_date: departureDate,
        name: formData.get('name'),
        email: formData.get('email'),
        phone: formData.get('phone'),
        message: formData.get('message') || '',
        source: 'area89-website',
        timestamp: new Date().toISOString(),
      };

      try {
        const webhookUrl = import.meta.env.PUBLIC_WEBHOOK_URL;
        if (!webhookUrl) throw new Error('Webhook URL is not configured');
        const response = await fetch(webhookUrl, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data),
        });
        if (!response.ok) throw new Error(`Webhook request failed with status ${response.status}`);

        bookingForm.classList.add('hidden');
        bookingConfirm.classList.remove('hidden');
        const reservationLabel = reservationType.selectedOptions[0]?.textContent?.trim() || 'Reserva';
        const message = encodeURIComponent(
          `Hola, quiero solicitar una reserva en Área 89\n\n` +
          `Tipo: ${reservationLabel}\n` +
          `Llegada: ${formatDate(arrivalDateInput.value)}\n` +
          `Duración: ${stayDays} día${stayDays === 1 ? '' : 's'}\n` +
          `Nombre: ${data.name}\nEmail: ${data.email}\nTeléfono: ${data.phone}`
        );
        whatsappBtn.href = `https://wa.me/573102067776?text=${message}`;
      } catch (error) {
        console.error(error);
        formError.textContent = 'No fue posible enviar la solicitud. Inténtalo nuevamente o contáctanos por WhatsApp.';
        formError.classList.remove('hidden');
        submitButton.textContent = 'Enviar solicitud';
        submitButton.disabled = false;
      }
    });

    btnNew.addEventListener('click', () => {
      bookingConfirm.classList.add('hidden');
      bookingDetails.classList.remove('hidden');
      detailsForm.reset();
      form.reset();
      stayDaysInput.value = '1';
      const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      submitButton.textContent = 'Enviar solicitud';
      submitButton.disabled = false;
      resetError();
    });
  }

  document.addEventListener('DOMContentLoaded', initBookingWidget);
  document.addEventListener('astro:page-load', initBookingWidget);
</script>
