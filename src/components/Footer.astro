---
const menuItems = [
  { label: 'Inicio', href: '/' },
  { label: 'La Villa', href: '/la-villa' },
  { label: 'Experiencias', href: '/experiencias' },
  { label: 'Galería', href: '/galeria' },
  { label: 'Contacto', href: '/contacto' },
];
---
<footer class="reveal">
  <div class="footer-upper">
    <div class="footer-grid">
      <div class="footer-col">
        <img src="/assets/images/logo-square.webp" alt="Área 89" style="width: 56px; height: 56px; border-radius: 12px; margin-bottom: 20px;" />
        <p>Área 89 — Magia pura al alcance de quienes aprecian la exclusividad.</p>
        <div class="footer-social-icons">
          <a href="https://www.facebook.com/area89rivera" target="_blank" rel="noopener" aria-label="Facebook">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="https://www.instagram.com/area89.rivera" target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </a>
          <a href="https://wa.me/573102067776" target="_blank" rel="noopener" aria-label="WhatsApp">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </a>
        </div>
      </div>
      <div class="footer-col">
        <h3>Contacto</h3>
        <ul>
          <li><a href="mailto:riveraarea89@gmail.com">riveraarea89@gmail.com</a></li>
          <li><a href="https://wa.me/573102067776" target="_blank" rel="noopener">+57 310 2067776</a></li>
          <li style="cursor: default;">A 1 km de Rivera (Huila), sobre la vía principal desde la doble calzada que conduce a Neiva.</li>
        </ul>
      </div>
      <div class="footer-col">
        <h3>Links Rápidos</h3>
        <ul>
          {menuItems.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
  <div class="footer-lower">
    <div class="footer-lower-inner">
      <p>© 2026 Área 89. Todos los derechos reservados.</p>
      <p>Rivera, Huila — Colombia</p>
    </div>
  </div>
</footer>

