<div class="preloader" id="preloader">
  <div class="type-line">
    <span id="typed-text"></span><span class="cursor" id="preloader-cursor"></span>
  </div>
</div>

<script is:inline>
(function() {
  var FULL_TEXT = 'Área 89';
  var typed = 0;
  var typedEl = document.getElementById('typed-text');
  var preloader = document.getElementById('preloader');
  var cursor = document.getElementById('preloader-cursor');

  function typeNext() {
    if (typed < FULL_TEXT.length) {
      typedEl.textContent += FULL_TEXT[typed];
      typed++;
      setTimeout(typeNext, 140);
    } else {
      setTimeout(function() {
        preloader.classList.add('lifting');
      }, 600);
      setTimeout(function() {
        preloader.style.display = 'none';
      }, 2200);
    }
  }

  setTimeout(typeNext, 600);
})();
</script>
