  '/assets/all-images/Fachada-4.webp',
  '/assets/all-images/Aérea-1.webp',
  '/assets/all-images/Aérea-2.webp',
  '/assets/all-images/Aérea-3.webp',
  '/assets/all-images/Piscina-1---1.webp',
  '/assets/all-images/Piscina-1---2.webp',
  '/assets/all-images/Piscina-1---3.webp',
  '/assets/all-images/Piscina-1---4.webp',
  '/assets/all-images/Piscina-2---1.webp',
  '/assets/all-images/Piscina-2---2.webp',
  '/assets/all-images/Jacuzzi-1.webp',
  '/assets/all-images/Jacuzzi-2.webp',
  '/assets/all-images/Jacuzzi-3.webp',
  '/assets/all-images/Terraza-1.webp',
  '/assets/all-images/Terraza-2.webp',
  '/assets/all-images/Terraza-3.webp',
  '/assets/all-images/Terrazas-9.webp',
  '/assets/all-images/Terrazas-10.webp',
  '/assets/all-images/Bar-BBQ-1.webp',
  '/assets/all-images/Bar-BBQ-2.webp',
  '/assets/all-images/Bar-BBQ-3.webp',
  '/assets/all-images/Sala---Cocina-1.webp',
  '/assets/all-images/Sala---Cocina-2.webp',
  '/assets/all-images/Sala---Cocina-3.webp',
  '/assets/all-images/Dormitorio-1---1.webp',
  '/assets/all-images/Dormitorio-1---2.webp',
  '/assets/all-images/Dormitorio-2---1.webp',
  '/assets/all-images/Dormitorio-2---2.webp',
  '/assets/all-images/Dormitorio-3---1.webp',
  '/assets/all-images/Dormitorio-3---2.webp',
  '/assets/all-images/Dormitorio-4---1.webp',
